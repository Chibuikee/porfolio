---
import { Image } from 'astro:assets';
import Icon from './icons/Icon.astro';
import { artBySlug } from './art';
import { flagships, sideProjects } from '@/data/cv';

// Screenshots are captured by `npm run screenshots` into src/assets/projects/<slug>.webp.
// A missing file falls back to a tile with the project's initials.
const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*.{png,jpg,webp}', { eager: true });
const shotFor = (slug: string) => {
  const hit = Object.entries(shots).find(([path]) => /\/([^/]+)\.[a-z]+$/.exec(path)?.[1] === slug);
  return hit?.[1].default;
};
const initials = (name: string) => {
  const words = name.split(/\s+/);
  return (words.length > 1 ? words[0][0] + words[1][0] : name.slice(0, 2)).toUpperCase();
};
---

<section id="work" class="py-24 md:py-32">
  <div class="wrap">
    <h2 class="section-title">Selected work</h2>
    <p class="section-lede">Four systems in production, numbered the way a barrister numbers evidence. Each has a case study.</p>

    <div class="mt-14 flex flex-col gap-20 md:mt-20 md:gap-28">
      {
        flagships.map((f, i) => {
          const Art = artBySlug[f.slug as keyof typeof artBySlug];
          const flip = i % 2 === 1;
          return (
            <article class="grid items-center gap-8 lg:grid-cols-12 lg:gap-14" data-reveal>
              <div class:list={['relative lg:col-span-7', { 'lg:order-2': flip }]}>
                <div class="relative rounded-2xl border border-line bg-ink-deep p-4 sm:p-7">
                  <span
                    class="absolute -top-4 left-5 -rotate-2 rounded-sm border-2 border-brass bg-ink px-3 py-1 font-display text-lg font-bold leading-none text-brass"
                    style="font-stretch: 85%"
                  >
                    Exhibit {f.exhibit}
                  </span>
                  <Art />
                </div>
              </div>

              <div class:list={['lg:col-span-5', { 'lg:order-1': flip }]}>
                <h3 class="font-display text-step-3 font-bold" style="font-stretch: 90%">{f.name}</h3>
                <p class="mt-2 text-step-1 leading-snug text-paper">{f.tagline}</p>
                <p class="mt-3 font-display text-[0.95rem] text-muted">
                  {f.role}
                  <span class="mt-0.5 block">{f.period}</span>
                </p>

                <ul class="mt-6 space-y-3 text-[1.02rem] leading-relaxed text-muted">
                  {
                    f.highlights.map((h) => (
                      <li class="flex gap-3">
                        <span class="mt-[0.7em] h-px w-4 shrink-0 bg-signal" aria-hidden="true" />
                        <span>{h}</span>
                      </li>
                    ))
                  }
                </ul>

                <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technologies">
                  {f.tags.map((t) => <li class="chip">{t}</li>)}
                </ul>

                <div class="mt-8 flex flex-wrap items-center gap-3">
                  <a href={`/projects/${f.slug}`} class="btn btn-primary min-h-11">
                    Read the case study
                    <Icon name="arrow" size={16} />
                  </a>
                  <a href={f.url} target="_blank" rel="noopener" class="btn btn-ghost min-h-11" aria-label={`${f.name} live site, ${f.urlLabel} (opens in a new tab)`}>
                    {f.urlLabel}
                    <Icon name="external" size={16} />
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <h3 class="mt-28 font-display text-step-2 font-bold md:mt-36" style="font-stretch: 90%" data-reveal>More shipped work</h3>
    <ul class="mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        sideProjects.map((p) => {
          const shot = shotFor(p.slug);
          return (
            <li>
              <a
                href={p.url}
                target="_blank"
                rel="noopener"
                aria-label={`${p.name}, ${p.urlLabel} (opens in a new tab)`}
                class="group block rounded-lg outline-offset-8"
              >
                <div class="relative aspect-[8/5] overflow-hidden rounded-lg border border-line bg-panel transition-colors group-hover:border-signal-dim group-focus-visible:border-signal-dim">
                  {shot ? (
                    <Image
                      src={shot}
                      width={960}
                      height={600}
                      format="webp"
                      loading="lazy"
                      alt={`${p.name} website screenshot`}
                      class="h-full w-full object-cover object-top transition-transform duration-700 ease-out-quart group-hover:scale-[1.04] group-hover:-translate-y-1 group-focus-visible:scale-[1.04]"
                    />
                  ) : (
                    <div class="tile flex h-full w-full items-center justify-center" aria-hidden="true">
                      <span class="font-display text-5xl font-bold text-paper/70" style="font-stretch: 80%">
                        {initials(p.name)}
                      </span>
                    </div>
                  )}
                </div>
                <h4 class="mt-4 flex items-center gap-2 font-display text-step-1 font-semibold leading-tight text-paper transition-colors group-hover:text-signal">
                  {p.name}
                  <Icon name="external" size={16} class="shrink-0 opacity-60" />
                </h4>
                <p class="mt-1 text-[1.02rem] leading-snug text-muted">{p.summary}</p>
                <p class="mt-3 font-display text-sm text-signal-dim group-hover:text-signal">{p.urlLabel}</p>
                <ul class="mt-3 flex flex-wrap gap-2" aria-hidden="true">
                  {p.tags.map((t) => <li class="chip">{t}</li>)}
                </ul>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .tile {
    background:
      radial-gradient(circle at 20% 15%, color-mix(in oklab, var(--color-signal) 28%, transparent), transparent 55%),
      linear-gradient(135deg, var(--color-panel), var(--color-ink-deep));
  }
</style>
