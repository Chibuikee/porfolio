---
import Icon from './icons/Icon.astro';
import { profile } from '@/data/cv';
const year = new Date().getFullYear();
---

<footer class="border-t border-line py-10">
  <div class="wrap flex flex-col gap-6 text-sm text-muted md:flex-row md:items-center md:justify-between">
    <p>© {year} {profile.fullName}. Code that holds up in production, arguments that hold up in court.</p>
    <ul class="flex items-center gap-1" aria-label="Profiles">
      <li><a href={profile.links.github} class="grid size-11 place-items-center rounded-full hover:text-signal" rel="me noopener" target="_blank"><Icon name="github" size={18} label="GitHub" /></a></li>
      <li><a href={profile.links.linkedin} class="grid size-11 place-items-center rounded-full hover:text-signal" rel="me noopener" target="_blank"><Icon name="linkedin" size={18} label="LinkedIn" /></a></li>
      <li><a href={profile.links.x} class="grid size-11 place-items-center rounded-full hover:text-signal" rel="me noopener" target="_blank"><Icon name="x" size={16} label="X" /></a></li>
      <li><a href={`mailto:${profile.email}`} class="grid size-11 place-items-center rounded-full hover:text-signal"><Icon name="mail" size={18} label="Email" /></a></li>
    </ul>
  </div>
</footer>
