---
import { experience } from '@/data/cv';

// Bullets shown before the rest fold into a native <details>.
const PREVIEW = 3;
const isCurrent = (period: string) => period.includes('Present');
---

<section id="experience" class="py-24 md:py-32">
  <div class="wrap">
    <h2 class="section-title">Experience</h2>
    <p class="section-lede">Product and contract roles since 2023, from the platforms I run to the codebases I took over.</p>

    <div class="rail-wrap mt-14 md:mt-20" data-rail>
      <div class="spine" aria-hidden="true"><div class="spine-fill"></div></div>

      <ol class="rail">
        {
          experience.map((role) => {
            const current = isCurrent(role.period);
            const head = role.bullets.slice(0, PREVIEW);
            const rest = role.bullets.slice(PREVIEW);
            return (
              <li class="role">
                <span class:list={['node', { current }]} aria-hidden="true" data-node />

                <div class="gutter">
                  <p class="period">
                    <time datetime={role.start}>{role.period}</time>
                  </p>
                  <p class="company">{role.company}</p>
                </div>

                <div class="body">
                  <h3 class="role-title">
                    {role.title}
                    <span class="sr-only"> at {role.company}</span>
                  </h3>
                  {role.context && <p class="context">{role.context}</p>}

                  <ul class="bullets">
                    {head.map((b) => <li>{b}</li>)}
                  </ul>
                  {
                    rest.length > 0 && (
                      <details class="more">
                        <summary>
                          <span class="when-closed">Show {rest.length} more</span>
                          <span class="when-open">Show fewer</span>
                        </summary>
                        <ul class="bullets">
                          {rest.map((b) => <li>{b}</li>)}
                        </ul>
                      </details>
                    )
                  }

                  <ul class="tech" aria-label={`Technologies at ${role.company}`}>
                    {role.tech.map((t) => <li class="chip">{t}</li>)}
                  </ul>

                  {
                    role.project && (
                      <p class="mt-5">
                        <a href={`/projects/${role.project}`} class="link case">
                          Read the case study<span class="sr-only"> for {role.company}</span>
                        </a>
                      </p>
                    )
                  }
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .rail-wrap {
    --spine-x: 0.45rem;
    --node: 0.9rem;
    position: relative;
  }
  @media (min-width: 48rem) {
    .rail-wrap {
      --spine-x: calc(11rem + 1.25rem);
    }
  }

  /* The spine: a hairline track, with a signal fill that draws down it as you scroll. */
  .spine {
    position: absolute;
    top: 0.75rem;
    bottom: 0;
    left: var(--spine-x);
    width: 2px;
    translate: -1px 0;
    background: var(--color-line);
    view-timeline: --spine block;
    mask-image: linear-gradient(to bottom, #000 calc(100% - 5rem), transparent);
  }
  .spine-fill {
    height: 100%;
    background: linear-gradient(to bottom, var(--color-signal-dim), var(--color-signal));
    transform-origin: top;
    /* Without scroll-driven animation or JS the spine is simply drawn. */
    transform: scaleY(var(--draw, 1));
  }
  @supports (animation-timeline: view()) {
    .spine-fill {
      /* Longhands on purpose: the CSS minifier folds a full set into a shorthand that drops the timeline. */
      animation-name: draw;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --spine;
      animation-range: cover 10% cover 90%;
    }
    .node {
      animation-name: light;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: cover 40% cover 55%;
    }
  }
  @keyframes draw {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  @keyframes light {
    from {
      border-color: var(--color-line);
      background-color: var(--color-ink);
    }
    to {
      border-color: var(--color-signal);
      background-color: var(--color-signal);
    }
  }

  .rail {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .role {
    position: relative;
    padding: 0 0 3.5rem 2rem;
  }
  .role:last-child {
    padding-bottom: 0;
  }
  @media (min-width: 48rem) {
    .role {
      display: grid;
      grid-template-columns: 11rem 2.5rem 1fr;
      padding: 0 0 4.5rem;
    }
    .gutter {
      grid-column: 1;
      grid-row: 1;
      align-self: start;
      position: sticky;
      top: 6rem;
    }
    .body {
      grid-column: 3;
      grid-row: 1;
    }
  }

  .node {
    position: absolute;
    top: 0.3rem;
    left: var(--spine-x);
    width: var(--node);
    height: var(--node);
    translate: -50% 0;
    border-radius: 999px;
    border: 2px solid var(--color-signal);
    background: var(--color-signal);
    z-index: 1;
  }
  @media (min-width: 48rem) {
    .node {
      left: var(--spine-x);
    }
  }
  .role:not(:first-child) .node:not(.current) {
    box-shadow: 0 0 0 4px var(--color-ink);
  }
  /* A live role pulses. */
  .node.current::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    border: 2px solid var(--color-signal);
    opacity: 0;
    animation: ping 2.6s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    80%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  /* JS fallback: the script sets --draw and toggles .is-lit. */
  .rail-wrap.js-scroll .node:not(.is-lit) {
    border-color: var(--color-line);
    background-color: var(--color-ink);
  }
  .node {
    transition:
      border-color 0.3s,
      background-color 0.3s;
  }

  .period {
    font-family: var(--font-display);
    font-stretch: 85%;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .company {
    font-family: var(--font-display);
    font-stretch: 80%;
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.15;
    letter-spacing: -0.005em;
    color: var(--color-paper);
    margin-top: 0.15rem;
  }
  @media (min-width: 48rem) {
    .company {
      margin-top: 0.4rem;
    }
  }

  .body {
    margin-top: 0.6rem;
  }
  @media (min-width: 48rem) {
    .body {
      margin-top: 0;
    }
  }
  .role-title {
    font-size: 1.15rem;
    font-weight: 600;
    font-stretch: 92%;
    line-height: 1.3;
    color: var(--color-signal);
  }
  @media (min-width: 48rem) {
    .role-title {
      line-height: 1.5;
    }
  }
  .context {
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-style: italic;
    max-width: 62ch;
  }

  .bullets {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    max-width: 66ch;
    font-size: 1.04rem;
    line-height: 1.55;
  }
  .bullets li {
    position: relative;
    padding-left: 1.1rem;
    color: color-mix(in oklab, var(--color-paper) 88%, var(--color-ink));
  }
  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 0.55rem;
    height: 1px;
    background: var(--color-signal-dim);
  }

  .more summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    cursor: pointer;
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.98rem;
    color: var(--color-signal);
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .more summary::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: -45deg;
    transition: rotate 0.25s var(--ease-out-quart);
  }
  .more[open] summary::before {
    rotate: 45deg;
  }
  .more .when-open,
  .more[open] .when-closed {
    display: none;
  }
  .more[open] .when-open {
    display: inline;
  }
  .more[open] .bullets {
    margin-top: 0.5rem;
  }
  .more summary:hover {
    color: #4fd3f7;
  }

  .tech {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .case {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .spine-fill,
    .node {
      animation: none;
      transform: none;
    }
    .node {
      border-color: var(--color-signal);
      background-color: var(--color-signal);
    }
    .node.current::after {
      animation: none;
      opacity: 0.35;
      transform: scale(1.7);
    }
    .rail-wrap.js-scroll .node:not(.is-lit) {
      border-color: var(--color-signal);
      background-color: var(--color-signal);
    }
  }
</style>

<script>
  // Fallback for browsers without scroll-driven animations: the same effect from a
  // scroll handler. --draw is how much of the spine is filled; nodes light as they pass.
  const wrap = document.querySelector<HTMLElement>('[data-rail]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (wrap && !reduced && !CSS.supports('animation-timeline: view()')) {
    wrap.classList.add('js-scroll');
    const spine = wrap.querySelector<HTMLElement>('.spine')!;
    const nodes = [...wrap.querySelectorAll<HTMLElement>('[data-node]')];
    let queued = false;

    const update = () => {
      queued = false;
      const mid = innerHeight * 0.5;
      const r = spine.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
      wrap.style.setProperty('--draw', p.toFixed(4));
      for (const n of nodes) n.classList.toggle('is-lit', n.getBoundingClientRect().top < mid);
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    update();
  }
</script>
