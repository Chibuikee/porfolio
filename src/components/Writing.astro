---
import { articles } from '@/data/cv';

const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<section id="writing" class="py-24 md:py-32">
  <div class="wrap">
    <h2 class="section-title">Writing</h2>
    <p class="section-lede">Notes from running these systems in production.</p>

    <ul class="writing mt-12 md:mt-16">
      {
        articles.map((a) => (
          <li class="row">
            <p class="meta">
              <time datetime={a.date}>{fmt.format(new Date(a.date))}</time>
              <span aria-hidden="true"> · </span>
              {a.outlet}
            </p>
            <div>
              <h3 class="title">
                <a href={a.url} class="link" rel="noopener" target="_blank">{a.title}</a>
              </h3>
              <p class="summary measure">{a.summary}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .writing {
    list-style: none;
    margin-block-end: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-line);
  }
  .row {
    position: relative;
    display: grid;
    gap: 0.6rem 2rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 14rem 1fr;
      padding: 1.7rem 0;
    }
  }
  .row::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    height: 1px;
    width: 100%;
    background: var(--color-signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out-quart);
  }
  .meta {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-muted);
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 85%;
    font-weight: 650;
    font-size: 1.3rem;
    line-height: 1.3;
    color: var(--color-paper);
  }
  .summary {
    margin: 0.6rem 0 0;
    font-size: 1.04rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
  @media (hover: hover) {
    .row:hover::before {
      transform: scaleX(1);
    }
  }
</style>
