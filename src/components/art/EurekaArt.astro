---
// Scholarships scattered in a vector space. A student profile (the query)
// appears, the gates remove ineligible scholarships, the nearest ones are drawn
// in and settle into three fit tiers, the rest fade. 11s CSS loop; the static
// (reduced-motion) state is the settled result.
const QX = 280;
const QY = 148;
const radii = [44, 82, 120];
const tierFill = ['var(--color-signal)', '#4fd3f7', 'var(--color-signal-dim)'];

// Seeded so the picture is identical on every build.
let seed = 7;
const rnd = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

type Dot = { x: number; y: number; r: number; kind: 'near' | 'gated' | 'far'; tier?: number; dx?: number; dy?: number; k: number };
const dots: Dot[] = [];

// Nearest eligible scholarships: scattered 130-215 away, destined for a ring slot.
const slots = [
  ...[-70, 55, 185].map((a) => ({ tier: 0, a })),
  ...[-110, -35, 40, 115, 200].map((a) => ({ tier: 1, a })),
  ...[-150, -95, -40, 15, 70, 125].map((a) => ({ tier: 2, a })),
];
slots.forEach((s, i) => {
  const ang = ((s.a + 360) % 360) * (Math.PI / 180);
  const tx = QX + Math.cos(ang) * radii[s.tier];
  const ty = QY + Math.sin(ang) * radii[s.tier];
  const sa = rnd() * Math.PI * 2;
  const sd = 135 + rnd() * 80;
  const x = clamp(QX + Math.cos(sa) * sd, 14, 466);
  const y = clamp(QY + Math.sin(sa) * sd * 0.75, 18, 282);
  dots.push({ x, y, r: [6, 5, 4.4][s.tier], kind: 'near', tier: s.tier, dx: tx - x, dy: ty - y, k: i % 12 });
});

// Everything else sits outside the outer ring: gated (ineligible) or merely far.
const place = (kind: 'gated' | 'far', n: number) => {
  for (let i = 0; i < n; i++) {
    let x = 0;
    let y = 0;
    do {
      x = 14 + rnd() * 452;
      y = 18 + rnd() * 266;
    } while (Math.hypot(x - QX, (y - QY) * 1.0) < 136);
    dots.push({ x, y, r: 3.2 + rnd() * 1.2, kind, k: i % 12 });
  }
};
place('gated', 17);
place('far', 15);

const orbits = radii.map((r, i) => ({ r, label: `Tier ${i + 1}`, i }));
---

<div class="art" data-art-eureka>
  <svg viewBox="0 0 480 320" role="img" aria-labelledby="eu-art-title eu-art-desc">
    <title id="eu-art-title">Eureka matching scholarships to a student</title>
    <desc id="eu-art-desc">
      Scholarships are scattered in a vector space. A student profile appears, hard eligibility gates remove the ineligible
      ones, dense retrieval pulls the nearest toward the student, and LLM scoring settles them into three fit tiers while the
      rest fade.
    </desc>
    <defs>
      <pattern id="eu-grid" width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M24 0H0V24" fill="none" stroke="#233e5c" stroke-width="0.6"></path>
      </pattern>
      <radialGradient id="eu-fade" cx="58%" cy="46%" r="62%">
        <stop offset="0.35" stop-color="#fff"></stop>
        <stop offset="1" stop-color="#000"></stop>
      </radialGradient>
      <mask id="eu-mask"><rect width="480" height="320" fill="url(#eu-fade)"></rect></mask>
    </defs>
    <rect width="480" height="320" fill="url(#eu-grid)" mask="url(#eu-mask)" opacity="0.7"></rect>

    <g fill="none">
      {orbits.map((r) => <circle cx={QX} cy={QY} r={r.r} class={`orbit orbit-${r.i + 1}`} />)}
    </g>

    <g class="dots">
      {
        dots.map((d) => (
          <circle
            cx={d.x.toFixed(1)}
            cy={d.y.toFixed(1)}
            r={d.r}
            class={`dot ${d.kind}`}
            style={`--k:${d.k};${d.kind === 'near' ? `--dx:${d.dx!.toFixed(1)}px;--dy:${d.dy!.toFixed(1)}px;--tier:${tierFill[d.tier!]}` : ''}`}
          />
        ))
      }
    </g>

    <g class="tier-labels" font-family="var(--font-display)">
      {orbits.map((r) => <text x={QX} y={QY - r.r - 6} text-anchor="middle" class={`tlabel tl-${r.i + 1}`}>{r.label}</text>)}
    </g>

    <g class="query" transform={`translate(${QX} ${QY})`}>
      <circle r="9" class="q-ping"></circle>
      <circle r="9" class="q-ping q-ping-2"></circle>
      <circle r="7" class="q-core"></circle>
    </g>
    <text x={QX} y={QY + 28} text-anchor="middle" class="q-label">Student</text>

    <g class="steps" font-family="var(--font-display)">
      <text x="16" y="308" class="step s1">1 Gates</text>
      <text x="82" y="308" class="step s2">2 Dense retrieval</text>
      <text x="200" y="308" class="step s3">3 LLM scoring</text>
    </g>
    <text x="16" y="22" class="axis">Scholarships in vector space</text>
  </svg>
</div>

<style>
  .art svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .orbit {
    stroke: var(--color-line);
    stroke-width: 1.5;
    stroke-dasharray: 800;
    stroke-dashoffset: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: rotate(-90deg);
  }
  .orbit-1 {
    stroke: var(--color-signal-dim);
  }
  .dot {
    fill: var(--color-muted);
  }
  .dot.near {
    fill: var(--tier);
    transform: translate(var(--dx), var(--dy));
  }
  .dot.gated,
  .dot.far {
    opacity: 0.14;
  }
  .tlabel {
    font-size: 12.5px;
    font-weight: 500;
    fill: var(--color-muted);
  }
  .tl-1 {
    fill: var(--color-signal);
  }
  .q-core {
    fill: var(--color-signal);
    stroke: var(--color-ink);
    stroke-width: 2.5;
    filter: drop-shadow(0 0 6px var(--color-signal));
  }
  .q-ping {
    fill: none;
    stroke: var(--color-signal);
    stroke-width: 1.5;
    opacity: 0;
  }
  .q-label {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    fill: var(--color-paper);
  }
  .step {
    font-size: 13px;
    font-weight: 500;
    fill: var(--color-muted);
  }
  .axis {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--color-muted);
    opacity: 0.8;
  }

  /* 11s loop. Dots are offset from each other by a few tenths of a second
     (negative delay) so they converge as a flock, not in lockstep. */
  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation-duration: 11s;
      animation-iteration-count: infinite;
      animation-timing-function: var(--ease-out-quart);
      animation-delay: calc(var(--k) * -0.05s);
    }
    .dot.near {
      animation-name: near;
    }
    .dot.gated {
      animation-name: gated;
    }
    .dot.far {
      animation-name: far;
    }
    .orbit {
      animation-duration: 11s;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }
    .orbit-1 {
      animation-name: ring1;
    }
    .orbit-2 {
      animation-name: ring2;
    }
    .orbit-3 {
      animation-name: ring3;
    }
    .tlabel {
      animation: tlabel 11s linear infinite backwards;
    }
    .tl-2 {
      animation-delay: 0.25s;
    }
    .tl-3 {
      animation-delay: 0.5s;
    }
    .query {
      animation: query 11s var(--ease-out-quart) infinite;
    }
    .q-label {
      animation: qlabel 11s linear infinite;
    }
    .q-ping {
      animation: qping 2.2s var(--ease-out-quart) infinite;
    }
    .q-ping-2 {
      animation-delay: 1.1s;
    }
    .s1 {
      animation: step1 11s linear infinite;
    }
    .s2 {
      animation: step2 11s linear infinite;
    }
    .s3 {
      animation: step3 11s linear infinite;
    }
  }

  @keyframes near {
    0% {
      opacity: 0;
      transform: translate(0, 0);
      fill: var(--color-muted);
    }
    6%,
    34% {
      opacity: 1;
      transform: translate(0, 0);
      fill: var(--color-muted);
    }
    50% {
      opacity: 1;
      transform: translate(var(--dx), var(--dy));
      fill: var(--color-muted);
    }
    58%,
    92% {
      opacity: 1;
      transform: translate(var(--dx), var(--dy));
      fill: var(--tier);
    }
    96% {
      opacity: 0;
      transform: translate(var(--dx), var(--dy));
      fill: var(--tier);
    }
    97%,
    100% {
      opacity: 0;
      transform: translate(0, 0);
      fill: var(--color-muted);
    }
  }
  @keyframes gated {
    0% {
      opacity: 0;
    }
    6%,
    20% {
      opacity: 0.8;
    }
    30%,
    92% {
      opacity: 0.14;
    }
    96%,
    100% {
      opacity: 0;
    }
  }
  @keyframes far {
    0% {
      opacity: 0;
    }
    6%,
    36% {
      opacity: 0.8;
    }
    48%,
    92% {
      opacity: 0.14;
    }
    96%,
    100% {
      opacity: 0;
    }
  }
  @keyframes ring1 {
    0%,
    42% {
      stroke-dashoffset: 800;
    }
    50%,
    92% {
      stroke-dashoffset: 0;
    }
    96%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
  @keyframes ring2 {
    0%,
    45% {
      stroke-dashoffset: 800;
    }
    53%,
    92% {
      stroke-dashoffset: 0;
    }
    96%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
  @keyframes ring3 {
    0%,
    48% {
      stroke-dashoffset: 800;
    }
    56%,
    92% {
      stroke-dashoffset: 0;
    }
    96%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
  @keyframes tlabel {
    0%,
    56% {
      opacity: 0;
    }
    62%,
    92% {
      opacity: 1;
    }
    96%,
    100% {
      opacity: 0;
    }
  }
  @keyframes query {
    0%,
    8% {
      opacity: 0;
      transform: translate(280px, 148px) scale(0.2);
    }
    14%,
    92% {
      opacity: 1;
      transform: translate(280px, 148px) scale(1);
    }
    96%,
    100% {
      opacity: 0;
      transform: translate(280px, 148px) scale(1);
    }
  }
  @keyframes qlabel {
    0%,
    12% {
      opacity: 0;
    }
    18%,
    92% {
      opacity: 1;
    }
    96%,
    100% {
      opacity: 0;
    }
  }
  @keyframes qping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    80%,
    100% {
      transform: scale(3.4);
      opacity: 0;
    }
  }
  @keyframes step1 {
    0%,
    16% {
      fill: var(--color-muted);
    }
    19%,
    33% {
      fill: var(--color-signal);
    }
    36%,
    100% {
      fill: var(--color-muted);
    }
  }
  @keyframes step2 {
    0%,
    34% {
      fill: var(--color-muted);
    }
    37%,
    52% {
      fill: var(--color-signal);
    }
    55%,
    100% {
      fill: var(--color-muted);
    }
  }
  @keyframes step3 {
    0%,
    53% {
      fill: var(--color-muted);
    }
    56%,
    80% {
      fill: var(--color-signal);
    }
    84%,
    100% {
      fill: var(--color-muted);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-art-eureka]').forEach((root) => {
    const svg = root.querySelector('svg');
    if (!svg || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    new IntersectionObserver(([e]) => {
      for (const a of root.getAnimations({ subtree: true })) e.isIntersecting ? a.play() : a.pause();
    }).observe(root);
  });
</script>
