---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
---

<Base title="Page not found, Chibuike Ewenike" description="This page doesn't exist. Go back to Chibuike Ewenike's portfolio.">
  <meta name="robots" content="noindex" slot="head" />
  <Nav />
  <main id="main" class="wrap grid min-h-[80vh] content-center py-32">
    <p class="font-mono text-signal">404</p>
    <h1 class="mt-4 font-display text-[clamp(2.5rem,8vw,5rem)] font-bold" style="font-stretch: 80%">This page isn't here</h1>
    <p class="mt-4 max-w-[46ch] text-muted">The link may be from the old version of this site. Everything now lives on the home page and the four case studies.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Go to the home page</a>
      <a href="/#work" class="btn btn-ghost">See the work</a>
    </div>
  </main>
  <Footer />
</Base>
