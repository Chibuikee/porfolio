---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/icons/Icon.astro';
import { artBySlug } from '@/components/art';
import { flagships, experience } from '@/data/cv';

export function getStaticPaths() {
  return flagships.map((flagship, i) => ({
    params: { slug: flagship.slug },
    props: { flagship, next: flagships[(i + 1) % flagships.length] },
  }));
}

const { flagship, next } = Astro.props;
const role = experience.find((r) => r.project === flagship.slug);
const Art = artBySlug[flagship.slug as keyof typeof artBySlug];

const title = `${flagship.name} case study, Chibuike Ewenike`;
const origin = Astro.site!.origin;
const pageUrl = `${origin}/projects/${flagship.slug}`;
const jsonLd = [
  {
    '@type': 'CreativeWork',
    '@id': `${pageUrl}#casestudy`,
    name: `${flagship.name} case study`,
    headline: `${flagship.name}: ${flagship.tagline}`,
    description: flagship.description,
    url: pageUrl,
    abstract: flagship.tagline,
    keywords: flagship.tags.join(', '),
    inLanguage: 'en',
    isPartOf: { '@id': `${origin}/#website` },
    author: { '@id': `${origin}/#person` },
    about: { '@type': 'SoftwareApplication', name: flagship.name, url: flagship.url, applicationCategory: 'BusinessApplication', creator: { '@id': `${origin}/#person` } },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Chibuike Ewenike', item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: `${flagship.name} case study`, item: pageUrl },
    ],
  },
];
---

<Base title={title} description={flagship.description} ogType="article" jsonLd={jsonLd}>
  <Nav />
  <main id="main" class="pt-28 pb-24 md:pt-36 md:pb-32">
    <div class="wrap">
      <a href="/#work" class="inline-flex min-h-11 items-center gap-2 font-display text-[0.95rem] text-muted transition-colors hover:text-signal">
        <Icon name="arrow" size={16} class="rotate-180" />
        Back to selected work
      </a>

      <header class="mt-6 grid items-end gap-6 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-8">
          <span
            class="inline-block -rotate-2 rounded-sm border-2 border-brass px-3 py-1 font-display text-lg font-bold leading-none text-brass"
            style="font-stretch: 85%"
          >
            Exhibit {flagship.exhibit}
          </span>
          <h1 class="mt-5 font-display text-step-4 font-bold" style="font-stretch: 88%">{flagship.name}</h1>
          <p class="mt-3 max-w-[30ch] text-step-2 leading-snug text-paper">{flagship.tagline}</p>
        </div>
        <div class="lg:col-span-4 lg:pb-2">
          <p class="font-display text-[0.95rem] text-muted">
            {flagship.role}
            <span class="mt-0.5 block">{flagship.period}</span>
          </p>
          <a href={flagship.url} target="_blank" rel="noopener" class="btn btn-ghost mt-4 min-h-11" aria-label={`${flagship.name} live site, ${flagship.urlLabel} (opens in a new tab)`}>
            {flagship.urlLabel}
            <Icon name="external" size={16} />
          </a>
        </div>
      </header>

      <div class="mt-12 rounded-2xl border border-line bg-ink-deep p-4 sm:p-8 md:mt-16">
        <div class="mx-auto max-w-3xl">
          <Art />
        </div>
      </div>

      <section class="mt-20 grid gap-10 md:mt-28 lg:grid-cols-12 lg:gap-14" aria-labelledby="built">
        <div class="lg:col-span-7">
          <h2 id="built" class="section-title text-step-3">What I built</h2>
          {role?.context && <p class="section-lede measure">{role.context}</p>}
          {
            role && (
              <ul class="measure mt-8 space-y-5 text-muted">
                {role.bullets.map((b) => (
                  <li class="flex gap-4">
                    <span class="mt-[0.8em] h-px w-5 shrink-0 bg-signal" aria-hidden="true" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        {
          role && (
            <div class="lg:col-span-5">
              <h2 class="font-display text-step-1 font-semibold">Built with</h2>
              <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies">
                {role.tech.map((t) => <li class="chip">{t}</li>)}
              </ul>
            </div>
          )
        }
      </section>

      <nav class="mt-24 border-t border-line pt-10 md:mt-32" aria-label="Next exhibit">
        <a href={`/projects/${next.slug}`} class="group block min-h-11">
          <span class="font-display text-[0.95rem] text-brass">Next: Exhibit {next.exhibit}</span>
          <span class="mt-1 flex items-center gap-3 font-display text-step-3 font-bold transition-colors group-hover:text-signal" style="font-stretch: 90%">
            {next.name}
            <Icon name="arrow" size={26} class="transition-transform duration-300 group-hover:translate-x-1" />
          </span>
          <span class="mt-1 block text-muted">{next.tagline}</span>
        </a>
      </nav>
    </div>
  </main>
  <Footer />
</Base>
